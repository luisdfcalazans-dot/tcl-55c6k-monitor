# Copie para .env (no PC). No GitHub, os mesmos valores vão em Settings > Secrets and variables > Actions.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Alvos (opcional)
ALVO_PIX=2900
ALVO_PARCELADO=3000

# Canais públicos extras (opcional): TELEGRAM_CANAIS_EXTRA=canal1,canal2

# Grupos/canais privados com a sua conta (opcional, só no PC; gere com scripts/telegram_login.py)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# TELEGRAM_CHATS_USUARIO=@ENVOLTOTECH,@AquiSuaPromoBot
